# ---------------------------------------------------------------------------
# Metrica environment. Copy to .env.local and fill in. Nothing here reaches the
# client bundle except the two NEXT_PUBLIC_ Supabase values (safe by design:
# the anon key is protected by Row Level Security).
# ---------------------------------------------------------------------------

# Supabase (project must be created in an EU region — GDPR selling point)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used by the extraction route + account deletion. NEVER exposed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — server-only, used exclusively in /api/extract (Milestone 2)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe — server-only (Milestone 7)
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PRICE_SOLO=price_...
NEXT_PUBLIC_STRIPE_PRICE_STUDIO=price_...
NEXT_PUBLIC_STRIPE_PRICE_STUDIO_PLUS=price_...

# App base URL (used for auth redirects, share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local-only preview flag: renders the authenticated shell with demo data when
# Supabase is not configured, so the UI can be viewed without a live project.
# MUST be unset in production — auth is always enforced when Supabase is set.
NEXT_PUBLIC_METRICA_DEMO=
